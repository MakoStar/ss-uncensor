{
  "name": "ssuncensor",
  "version": "0.1.1-alpha.2",
  "private": true,
  "description": "星塔反和谐工具测试版",
  "license": "AGPL-3.0-or-later",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.js dev",
    "start": "node scripts/dev.js start",
    "selftest": "node scripts/dev.js selftest",
    "pipeline": "node scripts/dev.js pipeline",
    "build": "electron-vite build",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "icon": "node scripts/icon.js",
    "postinstall": "node scripts/setup.js",
    "dist": "electron-vite build && electron-builder --win --config"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.makostar.ssuncensor",
    "productName": "星塔反和谐工具",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "星塔反和谐工具",
      "uninstallDisplayName": "星塔反和谐工具 ${version}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "ssuncensor-${version}-setup.${ext}",
      "include": "build/installer.nsh",
      "differentialPackage": false
    },
    "copyright": "Copyright (C) 2026 MakoStar"
  },
  "author": "MakoStar"
}
