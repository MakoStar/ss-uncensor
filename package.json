{
  "name": "ssuncensor",
  "version": "1.0.0-beta",
  "private": true,
  "description": "星塔反和谐工具测试版",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.js dev",
    "start": "node scripts/dev.js start",
    "selftest": "node scripts/dev.js selftest",
    "pipeline": "node scripts/dev.js pipeline",
    "build": "electron-vite build",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "icon": "node scripts/icon.js",
    "postinstall": "node scripts/setup.js",
    "dist": "electron-vite build && electron-builder --win --config",
    "dist:setup": "electron-vite build && electron-builder --win nsis --config",
    "dist:zip": "electron-vite build && electron-builder --win zip --config",
    "check:imports": "node scripts/imports.js",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"scripts/**/*.js\" \"electron.vite.config.ts\""
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "pinia": "4.1.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vue": "3.5.45"
  },
  "build": {
    "appId": "com.makostar.ssuncensor",
    "productName": "星塔反和谐工具",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      {
        "from": "assets",
        "to": "resources",
        "filter": [
          "icon-256.png"
        ]
      },
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "ssuncensor-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "星塔反和谐工具",
      "uninstallDisplayName": "星塔反和谐工具 ${version}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "ssuncensor-${version}-setup.${ext}",
      "include": "assets/installer.nsh",
      "differentialPackage": false
    },
    "copyright": "Copyright (C) 2026 MakoStar"
  },
  "author": "MakoStar"
}
